node_modules/
dist/
# ...except the vendored provider build, which IS the thing we ship. Without
# this exception the `dist/` rule above silently swallows it and a fresh
# checkout cannot stage the bundle.
!vendor/**/dist/
!vendor/**/dist/**
out/
out-test/
*.vsix
.DS_Store
.claude/scheduled_tasks.lock
# Bundled OpenCode binary is fetched at package time, never committed.
bin/
# Ollama provider staged at package time by scripts/bundle-provider.js. The
# patched source it wraps lives in vendor/ and IS committed.
opencode-provider/
out-integration/
.vscode-test/
# Local scratch / agent-demo artifacts (not part of the extension).
tetris.html

# Playwright MCP run artifacts (created when testing the sample)
.playwright-mcp/

# Skill/MCP run artifacts created when testing the sample workspace
sample-workspace/.opencode/node_modules/
sample-workspace/.opencode/**/node_modules/

# Graphoxide code-graph output, regenerated on demand.
/graphoxide-out/
